# Server
PORT=4000

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h

# Seeded login (used by the seed script to create the default user)
SEED_USER_EMAIL=demo@taskboard.dev
SEED_USER_PASSWORD=password123

# SQLite database file (relative to the backend folder)
DATABASE_FILE=data/taskboard.db

# Allowed origin for the frontend dev server
CORS_ORIGIN=http://localhost:5173
